<view class="page" wx:if="{{word}}"><view class="between"><text class="eyebrow">ONE WORD, ONE MEANING</text><text wx:if="{{progress}}" class="pill">{{progress.statusLabel}}</text></view><view class="detail-word serif">{{word.word}}</view><view class="between"><text class="detail-phonetic">{{word.phonetic ? '/' + word.phonetic + '/' : '暂无音标'}}</text><button wx:if="{{canPlay}}" class="link" bindtap="speak">播放发音 ♬</button><button wx:else class="link" bindtap="copy">复制单词</button></view><view class="line"></view><view class="eyebrow">THE ONE TO REMEMBER</view><view class="detail-meaning"><text class="detail-pos">{{word.pos}}</text>{{word.coreMeaning}}</view><button class="detail-expand" bindtap="expand">{{expanded ? '收起其他词义 −' : '展开其他词义 ＋'}}</button><view wx:if="{{expanded}}" class="other-meanings"><view wx:for="{{word.meanings}}" wx:key="index" class="meaning-row"><text>{{item.pos}}</text>{{item.meaning}}</view></view><view wx:if="{{word.example}}" class="detail-example"><text class="eyebrow">IN A SENTENCE</text><view class="serif example-en">{{word.example.en}}</view><view class="example-zh">{{word.example.zh}}</view></view><view wx:if="{{progress}}" class="memory-card"><view class="between"><text class="section-title">这词的记忆</text><text class="small muted">{{progress.totalReviews}} 次相遇</text></view><view class="memory-due">下次复习<text>{{progress.dueLabel}}</text></view><view class="notice">到期后成功回忆才会拉长复习间隔，提前练习不会提升记忆等级。需要时也可以重新学习。</view></view><view class="source-note">所属词书 · {{bookNames}}</view><button class="secondary relearn" bindtap="relearn">{{progress && progress.status === 'unknown' ? '重新安排短间隔复习' : '还不熟，移入不认识词集'}}</button><button class="link back" bindtap="back">返回词集</button></view>
<view wx:else class="page empty"><view class="empty-mark serif">?</view><view class="empty-title">暂时找不到这个词</view><button class="secondary" bindtap="back">返回词集</button></view>

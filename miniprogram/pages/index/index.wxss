.masthead{padding:0 0 30rpx;border-bottom:1rpx solid #dce1d4}.brand{font-size:38rpx;letter-spacing:-1rpx;font-weight:600}.brand-en{margin-left:16rpx;font-size:35rpx;font-weight:400}.date{font-size:23rpx;color:#869080}.intro{padding:46rpx 0 40rpx}.greeting{margin-top:18rpx;font-size:65rpx;line-height:1.35;letter-spacing:0}.intro-copy{margin-top:22rpx;font-size:25rpx;color:#89917f}.section-heading .eyebrow{font-size:17rpx;letter-spacing:2rpx}.daily-grid{display:flex;gap:26rpx;margin:12rpx 0 34rpx}.daily-cell{flex:1}.daily-number{font-size:74rpx;line-height:1.3;color:#244d3d}.daily-denominator{font-size:27rpx;color:#99a28e}.daily-label{display:flex;align-items:center;gap:10rpx;color:#7c8777;font-size:24rpx}.dot{width:12rpx;height:12rpx;border-radius:50%}.lime{background:#bcc977}.green{background:#4a7561}.hero-card{padding:30rpx 32rpx 34rpx;background:#244d3d;border-radius:30rpx;text-align:left;color:#f6f5ef;overflow:hidden}.hero-kicker{font-size:18rpx;letter-spacing:3rpx;color:#b9c9ac}.hero-orbit{width:70rpx;height:70rpx;border:1rpx solid #6d8a63;border-radius:50%;font-family:Georgia,serif;font-style:italic;font-size:45rpx;color:#d3dda8;display:flex;justify-content:center;align-items:center}.hero-title{margin-top:13rpx;font-size:43rpx;font-weight:500}.hero-copy{margin-top:13rpx;color:#bdccbb;font-size:23rpx}.hero-bottom{margin-top:38rpx}.hero-button{display:flex;align-items:center;gap:44rpx;background:#e9ef9c;color:#244d3d;padding:20rpx 26rpx;border-radius:15rpx;font-size:26rpx}.hero-button text{font-size:32rpx}.hero-estimate{font-size:21rpx;color:#b2c2ab}.book-section{margin:38rpx 0 16rpx}.current-book{display:flex;gap:30rpx;text-align:left;padding:8rpx 0}.book-spine{flex:none;width:168rpx;min-height:217rpx;border-radius:5rpx 14rpx 14rpx 5rpx;background:#dce3c9;border-left:9rpx solid #b6c69c;padding:21rpx 17rpx;display:flex;flex-direction:column;justify-content:space-between}.book-cover-name{font-size:20rpx;font-weight:600;word-break:break-all}.book-cover-en{font-size:31rpx;line-height:1.1;color:#5f7954}.book-info{padding-top:6rpx;flex:1;min-width:0}.book-name{font-size:31rpx;font-weight:500;margin-top:11rpx}.book-sub{font-size:23rpx;margin-top:9rpx}.progress-track{height:5rpx;margin:22rpx 0 14rpx;background:#dfe5d5;border-radius:10rpx;overflow:hidden}.progress-fill{height:100%;background:#8ba66b;border-radius:10rpx}.gentle-note{display:flex;gap:19rpx;padding:42rpx 0 0;font-size:23rpx;color:#9aA08c;line-height:1.9}.note-mark{font-size:60rpx;line-height:1.2;color:#b7c1a4}.tutorial-copy{margin-top:20rpx}.gesture-demo{display:flex;align-items:center;justify-content:space-between;margin:38rpx 0}.gesture-side{display:flex;flex-direction:column;align-items:center;color:#7f8f74;font-size:21rpx;gap:8rpx}.gesture-side>text:first-child{font-size:42rpx}.mini-word{background:#fffef9;border:1rpx solid #dde3d3;box-shadow:0 8rpx 20rpx #244d3d08;padding:38rpx 30rpx;border-radius:20rpx;font-size:43rpx;transform:rotate(-5deg)}.mini-word text{display:block;font-family:sans-serif;font-size:24rpx;text-align:center;margin-top:10rpx}.tutorial-start{margin-top:30rpx}

.recovery-notice{margin-top:24rpx;font-size:22rpx}.pending-note{display:flex;gap:15rpx;margin:25rpx 0 0;font-size:23rpx;color:#6f855d;line-height:1.9}.pending-dot{width:11rpx;height:11rpx;border-radius:50%;background:#a9bb7d;flex:none;margin-top:15rpx}.pending-sub{font-size:20rpx;color:#9aa68b}

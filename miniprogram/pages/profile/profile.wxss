.profile-title{margin-top:20rpx;font-size:49rpx;line-height:1.5;letter-spacing:0}.profile-summary{display:flex;padding:34rpx 0;margin-top:13rpx;border-bottom:1rpx solid #dce2d3;gap:18rpx}.profile-summary>view{flex:1}.summary-number{font-size:58rpx;color:#244d3d}.profile-summary text{font-size:22rpx;color:#8b9781}.activity{margin:34rpx 0 20rpx}.activity-chart{display:flex;height:208rpx;gap:18rpx;align-items:flex-end;margin-top:22rpx}.chart-col{flex:1;display:flex;flex-direction:column;align-items:center}.chart-value{font-size:19rpx;color:#7d8b71;height:30rpx}.chart-track{height:120rpx;width:100%;display:flex;align-items:flex-end;justify-content:center}.chart-bar{width:34rpx;border-radius:6rpx 6rpx 0 0;background:#dee4d4}.has-activity{background:#a9bc85}.chart-day{font-size:19rpx;color:#8b9681;margin-top:12rpx}.settings{margin-top:32rpx;border-top:1rpx solid #dce2d3}.setting-row{min-height:110rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:25rpx 0;border-bottom:1rpx solid #dce2d3;text-align:left}.setting-name{font-size:28rpx;font-weight:500}.setting-description{font-size:22rpx;color:#8c9784;margin-top:6rpx;line-height:1.6}.setting-value{font-size:25rpx;color:#6c7e61;white-space:nowrap}.setting-value text{font-size:35rpx;margin-left:15rpx;color:#8e9c81}.brand-sign{margin-top:52rpx;font-size:45rpx;color:#99a98b;text-align:center;font-style:italic}.brand-motto{font-size:21rpx;color:#a3ac96;text-align:center;margin-top:8rpx}.panel-copy{margin-top:24rpx}.panel-button{margin-top:25rpx}.backup-copy{font-size:23rpx;margin-top:20rpx}.danger-button{font-size:24rpx;color:#a66c58;margin-top:33rpx;padding:15rpx}.backup-input{width:100%;height:320rpx;background:#e9ecdf;border:1rpx solid #d7dfca;border-radius:18rpx;margin-top:23rpx;padding:22rpx;font-size:23rpx;font-family:monospace}.error-message{font-size:24rpx;color:#a7654d;margin-top:15rpx}.memory-step{display:flex;gap:19rpx;margin:28rpx 0}.memory-dot{width:17rpx;height:17rpx;border-radius:50%;margin-top:12rpx;flex:none}.unknown-dot{background:#c6947a}.unsure-dot{background:#c1ba6d}.known-dot{background:#779774}.about-logo{font-size:74rpx;margin:22rpx 0;color:#244d3d;font-style:italic}.about-notice{margin-top:25rpx}


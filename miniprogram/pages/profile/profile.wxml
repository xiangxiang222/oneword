<view class="page">
  <view class="eyebrow">YOUR OWN PACE</view><view class="title profile-title">按自己的节奏，<view>让记忆生长。</view></view>
  <button class="account-card" bindtap="openAccount"><view class="account-mark">{{accountInitial}}</view><view class="grow"><view class="setting-name">{{account.user ? account.user.username : '登录，让记忆跟你走'}}</view><view class="account-status {{account.phase === 'offline' || account.phase === 'error' || account.phase === 'expired' ? 'account-pending' : ''}}">{{account.user ? syncLabel : '换一部手机，继续上次的学习'}}</view></view><text class="arrow">›</text></button>
  <view class="profile-summary"><view><view class="summary-number serif">{{stats.knownCount + stats.unknownCount + stats.unsureCount}}</view><text>已遇见的词</text></view><view><view class="summary-number serif">{{stats.masteredCount}}</view><text>已巩固的词</text></view><view><view class="summary-number serif">{{stats.streak}}</view><text>连续学习天数</text></view></view>
  <view class="activity"><view class="between"><text class="section-title">这一周的小积累</text><text class="small muted">学习判断次数</text></view><view class="activity-chart"><view wx:for="{{bars}}" wx:key="date" class="chart-col"><text class="chart-value">{{item.total || ''}}</text><view class="chart-track"><view class="chart-bar {{item.total ? 'has-activity' : ''}}" style="{{item.barStyle}}"></view></view><text class="chart-day">{{item.label}}</text></view></view></view>
  <view class="settings">
    <picker range="{{goalOptions}}" value="{{goalIndex}}" bindchange="goal"><view class="setting-row"><view><view class="setting-name">每日新词</view><view class="setting-description">到期复习优先，新词按量安排</view></view><view class="setting-value">{{settings.dailyGoal}} 词 <text>›</text></view></view></picker>
    <picker range="{{orderOptions}}" range-key="label" value="{{orderIndex}}" bindchange="learningOrder"><view class="setting-row order-setting"><view class="grow"><view class="setting-name">学习顺序</view><view class="setting-description">{{orderDescription}}</view><view class="setting-description order-effective">修改后，从下一组开始生效</view></view><view class="setting-value">{{orderOptions[orderIndex].label}} <text>›</text></view></view></picker>
    <view class="setting-row"><view class="grow"><view class="setting-name">先回忆，再揭晓</view><view class="setting-description">先想一想词义，再看答案</view></view><switch checked="{{settings.recallFirst}}" color="#244d3d" bindchange="recall" style="transform:scale(.78);transform-origin:right center" /></view>
    <button class="setting-row" bindtap="openPanel" data-panel="memory"><view class="grow"><view class="setting-name">复习为什么这样安排</view><view class="setting-description">了解间隔复习，让遗忘更从容</view></view><text class="arrow">›</text></button>
    <button class="setting-row" bindtap="tutorial"><text class="setting-name">再看一次使用指南</text><text class="arrow">›</text></button>
    <button class="setting-row" bindtap="openPanel" data-panel="data"><view class="grow"><view class="setting-name">数据与备份</view><view class="setting-description">{{account.user ? '云端同步 · 本机备份' : '游客本机存储 · 可登录同步'}}</view></view><text class="arrow">›</text></button>
    <button class="setting-row" bindtap="openPanel" data-panel="about"><text class="setting-name">关于一词</text><text class="arrow">›</text></button>
  </view>
  <view class="brand-sign serif">oneword.</view><view class="brand-motto">每次只记一个意思。</view>
</view>
<view wx:if="{{panel}}" class="sheet-mask" bindtap="closePanel"><view class="sheet" catchtap="noop"><view class="between"><text class="sheet-title">{{panel === 'account' ? (account.user && account.phase !== 'expired' ? '你的记忆，随身同行。' : '换个设备，也能继续。') : panel === 'memory' ? '在快忘记时，再遇见。' : panel === 'about' ? '小一点，也好一点。' : panel === 'import' ? '恢复学习记录' : '给记忆，多一份留存。'}}</text><button class="link" bindtap="closePanel" disabled="{{authBusy}}">关闭</button></view>
  <block wx:if="{{panel === 'account'}}">
    <view class="sheet-copy panel-copy">账号同步词集、复习计划、学习统计和设置。断网时仍可学习，联网后继续同步。</view>
    <block wx:if="{{!account.user || account.phase === 'expired'}}">
      <view class="auth-tabs"><button class="auth-tab {{authMode === 'login' ? 'auth-tab-active' : ''}}" bindtap="authMode" data-mode="login" disabled="{{authBusy}}">登录</button><button class="auth-tab {{authMode === 'register' ? 'auth-tab-active' : ''}}" bindtap="authMode" data-mode="register" disabled="{{authBusy}}">创建账号</button></view>
      <label class="auth-label">账号<input class="auth-input" value="{{username}}" data-field="username" bindinput="authInput" placeholder="3–32 位字母、数字或 _ . -" maxlength="32" disabled="{{authBusy}}" /></label>
      <label class="auth-label">密码<input class="auth-input" password value="{{password}}" data-field="password" bindinput="authInput" placeholder="8–128 位密码" maxlength="128" disabled="{{authBusy}}" bindconfirm="authenticate" /></label>
      <checkbox-group wx:if="{{!account.user}}" bindchange="mergeGuest"><label class="merge-option"><checkbox value="merge" checked="{{mergeGuest}}" color="#244d3d" disabled="{{authBusy}}" /><text>合并本机游客进度</text></label></checkbox-group>
      <view wx:if="{{authError}}" class="error-message">{{authError}}</view>
      <button class="primary panel-button" bindtap="authenticate" loading="{{authBusy}}" disabled="{{authBusy || !username || !password}}">{{authBusy ? '正在连接云端…' : authMode === 'register' ? '创建账号并同步' : '登录并继续学习'}}</button>
      <button wx:if="{{account.phase === 'expired'}}" class="link signout-button" bindtap="signOut" disabled="{{authBusy}}">退出账号，返回游客进度</button>
      <view class="sheet-copy backup-copy">{{authMode === 'register' ? '创建账号后，学习记录将同步到云端；未勾选合并时，游客记录独立保存在本机。' : '登录后，当前账号的词集、复习计划、每日统计和设置会自动同步。'}}密码通过 HTTPS 传输，云端仅保存加盐哈希。可在账号页注销账号并删除云端记录。</view>
      <view class="notice auth-notice">当前使用独立账号和密码，网页与小程序共用。请妥善保存密码，暂不支持短信找回。</view>
    </block>
    <block wx:else>
      <view class="account-current"><view class="setting-name">{{account.user.username}}</view><view class="account-status">{{syncLabel}}</view><view wx:if="{{syncTime}}" class="setting-description">上次同步：{{syncTime}}</view><view wx:if="{{account.message && account.phase !== 'idle'}}" class="setting-description">{{account.message}}</view></view>
      <view wx:if="{{authMode === 'login'}}">
        <button class="primary panel-button" bindtap="syncNow" loading="{{account.phase === 'syncing'}}" disabled="{{authBusy || account.phase === 'syncing'}}">立即同步</button>
        <button class="secondary panel-button" bindtap="authMode" data-mode="password" disabled="{{authBusy}}">修改密码</button>
        <button class="link signout-button" bindtap="signOut" disabled="{{authBusy}}">退出账号，返回游客进度</button>
        <button class="danger-button" bindtap="authMode" data-mode="delete" disabled="{{authBusy}}">注销账号</button>
      </view>
      <view wx:if="{{authMode === 'password'}}">
        <label class="auth-label">当前密码<input class="auth-input" password value="{{password}}" data-field="password" bindinput="authInput" placeholder="请输入当前密码" maxlength="128" disabled="{{authBusy}}" /></label>
        <label class="auth-label">新密码<input class="auth-input" password value="{{newPassword}}" data-field="newPassword" bindinput="authInput" placeholder="8–128 位新密码" maxlength="128" disabled="{{authBusy}}" /></label>
        <button class="primary panel-button" bindtap="savePassword" loading="{{authBusy}}" disabled="{{authBusy || !password || !newPassword}}">保存新密码</button>
        <button class="link signout-button" bindtap="authMode" data-mode="login" disabled="{{authBusy}}">返回账号</button>
      </view>
      <view wx:if="{{authMode === 'delete'}}">
        <view class="notice auth-notice">注销会永久删除账号与云端学习记录，无法撤销。请先在「数据与备份」导出备份。</view>
        <label class="auth-label">输入密码确认<input class="auth-input" password value="{{password}}" data-field="password" bindinput="authInput" placeholder="账号密码" maxlength="128" disabled="{{authBusy}}" /></label>
        <button class="danger-button" bindtap="deleteAccount" loading="{{authBusy}}" disabled="{{authBusy || !password}}">永久注销这个账号</button>
        <button class="link signout-button" bindtap="authMode" data-mode="login" disabled="{{authBusy}}">返回账号</button>
      </view>
      <view wx:if="{{authError}}" class="error-message">{{authError}}</view>
      <view class="sheet-copy backup-copy">登录后自动同步；退出会回到独立保存的游客进度。切换账号不会把前一个账号的记录合并进去。</view>
    </block>
  </block>
  <block wx:if="{{panel === 'memory'}}"><view class="sheet-copy panel-copy">记忆会随时间变淡，间隔复习让每次回忆更有价值。一词采用受遗忘曲线启发的透明规则，根据你的判断调整下次见面时间。</view><view class="memory-step"><view class="memory-dot unknown-dot"></view><view><view class="setting-name">不认识 · 更快重逢</view><view class="sheet-copy">5 分钟后重新巩固，历史学习记录会保留。</view></view></view><view class="memory-step"><view class="memory-dot unsure-dot"></view><view><view class="setting-name">不确定 · 缩短间隔</view><view class="sheet-copy">15 分钟后再见一次，给似懂非懂留一点时间。</view></view></view><view class="memory-step"><view class="memory-dot known-dot"></view><view><view class="setting-name">认识 · 慢慢拉长</view><view class="sheet-copy">到期回忆成功后，按 1、2、4、7、15、30、60、90 天逐步延长；提前练习不会提升记忆等级。</view></view></view><view class="notice">这是一套启发式间隔复习规则，不是对个人遗忘概率的精确预测，也不保证固定的记忆效果。「认识」词仍会安排复习。</view></block>
  <block wx:if="{{panel === 'data'}}"><view class="sheet-copy panel-copy">{{account.user ? '登录账号的学习记录会自动同步到云端。换设备后登录同一账号即可恢复；离线学习请在联网同步完成后再清理设备数据。' : '游客学习记录保存在当前微信设备内。登录账号可以同步到云端；换设备或清理微信数据前，请先登录同步或导出备份。'}}</view><button class="primary panel-button" bindtap="exportData">复制 JSON 备份</button><button class="secondary panel-button" bindtap="openPanel" data-panel="import">从 JSON 恢复</button><view class="sheet-copy backup-copy">备份包含词集、复习进度、每日统计和词书清单，不含账号密码。复制后请保存为文本；恢复会替换本机记录，登录时会同步到当前账号。完整词书需在恢复时联网补齐。</view><view wx:if="{{recovery.available}}" class="recovery-card"><view class="sheet-copy">有 {{recovery.count}} 份无法读取的原始记录已保留。导出用于人工检查，不会被新进度覆盖。</view><button class="secondary panel-button" bindtap="exportRecovery">导出异常记录原文</button></view><view wx:if="{{recovery.blocked}}" class="notice">{{recovery.warning}}</view><view wx:if="{{account.user}}" class="setting-description">要清空游客记录，请先退出账号。云端账号记录可在账号页注销删除。</view><button wx:else class="danger-button" bindtap="clearData">清空这台设备的学习记录</button></block>
  <block wx:if="{{panel === 'import'}}"><view class="sheet-copy panel-copy">粘贴通过「复制 JSON 备份」导出的完整内容。</view><textarea class="backup-input" placeholder="粘贴 JSON 备份…" value="{{importText}}" bindinput="inputImport" maxlength="-1" auto-height="false" /><view wx:if="{{importError}}" class="error-message">{{importError}}</view><button class="primary panel-button" bindtap="restore" disabled="{{!importText || restoring}}" loading="{{restoring}}">{{restoring ? '正在补齐词书与恢复…' : '校验并恢复记录'}}</button></block>
  <block wx:if="{{panel === 'about'}}"><view class="about-logo serif">oneword.</view><view class="sheet-copy">一词想把背单词变成一件轻盈的小事。一个核心意思，一次真实判断，一场恰好出现的复习。</view><view class="line"></view><view class="sheet-copy">词条基于开放词典资料整理，词库按实际收录量展示。核心意思用于快速学习，点击词条可以查看其他词义；具体语境中仍需要结合上下文理解。开放数据来源与许可见项目仓库的资料说明。</view><button class="link source-link" bindtap="copySource">复制开放词典来源链接 ↗</button><view class="notice about-notice">词书包括离线精选和可选的完整源标签词表，完整词表不等同于官方考试大纲。部分词条暂无音频。</view></block>
</view></view>

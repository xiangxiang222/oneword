.page-title{margin-top:20rpx;font-size:49rpx;letter-spacing:0}.page-subtitle{color:#8c9684;font-size:25rpx;margin-top:18rpx}.categories{display:flex;gap:15rpx;margin:22rpx 0 27rpx}.category{font-size:25rpx;border-radius:30rpx;padding:12rpx 24rpx;color:#84917c;background:#e9ecdf}.category-active{background:#244d3d;color:#f6f5ef}.books-notice{margin-bottom:30rpx;font-size:21rpx}.books-notice text{display:block;color:#87917b}.book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:30rpx;row-gap:35rpx}.book-card{text-align:left;padding:0 5rpx}.book-cover{height:302rpx;border-radius:4rpx 15rpx 15rpx 4rpx;padding:23rpx;border-left:9rpx solid #244d3d17;box-shadow:7rpx 7rpx 0 #244d3d07}.book-id{font-size:22rpx;text-transform:uppercase;color:#506745}.selected-mark{height:32rpx;width:32rpx;line-height:32rpx;text-align:center;border-radius:50%;background:#244d3d;color:#e9ef9c;font-size:22rpx}.cover-title{font-size:36rpx;line-height:1.5;margin-top:25rpx;min-height:58rpx;font-weight:500}.cover-rule{height:1rpx;background:#244d3d30;width:42rpx;margin:22rpx 0 16rpx}.cover-tagline{font-size:22rpx;color:#62775a;line-height:1.3;font-style:italic}.cover-tagline text{display:block}.book-title{font-size:27rpx;margin-top:20rpx;font-weight:500}.book-count{font-size:23rpx;color:#8c9682;margin-top:7rpx}.book-status{font-size:22rpx;color:#778969;margin-top:7rpx}.book-active .book-status{color:#244d3d;font-weight:500}.book-active .book-cover{box-shadow:0 0 0 3rpx #244d3d}.book-unavailable{opacity:.55}.back-learning{margin-top:45rpx}

.book-full{font-size:20rpx;color:#9aa48d;margin-top:7rpx;line-height:1.7}.storage-usage{font-size:20rpx;color:#9aa58c;line-height:1.9;margin-top:35rpx}
